generator kysely {
  provider = "prisma-kysely"

  output               = "../src/generated"
  fileName             = "kysely.ts"
  camelCase            = true
  dateTimeTypeOverride = "(string | Date)"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ENABLED
  DISABLED
}

enum Role {
  ADMIN
  MANAGER
  CLIENT
  ACCESS_MANAGER
}

model User {
  id        String @id @default(cuid())
  firstName String @map("first_name")
  lastName  String @map("last_name")
  institution String? @map("institution")
  email     String @unique

  imageId String? @unique @map("image_id")
  image   Media?  @relation(name: "image", fields: [imageId], references: [id], onDelete: SetNull)
  // Better Auth's optional URL is separate from our uploaded-media relation.
  authImageUrl String? @map("auth_image_url")

  role   Role       @default(CLIENT)
  status UserStatus @default(DISABLED)

  emailVerified Boolean @default(false) @map("email_verified")
  name          String

  receiveEmails Boolean @default(false) @map("receive_emails")

  // ban
  banned     Boolean?
  banReason  String?  @map("ban_reason")
  banExpires Int?     @map("ban_expires")

  phoneNumber   String?       @map("phone_number")
  phoneVerified Boolean       @default(false) @map("phone_verified")

  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at")
  Notification     Notification[]
  UserNotification UserNotification[]
  Session          Session[]
  Account          Account[]
  userActivity     UserActivity[]
  media            Media[]            @relation("media")
  gcRevisions      GCVerificationRevision[]
  gcMergeProposals GCMergeProposal[]
  gcMergeEvents    GCMergeEvent[]

  @@map("users")
}

// Human content review is independent of Better Auth's Verification OTP table.
model GCVerificationEntity {
  key String @id
  kind String
  original Json
  revision Int @default(0)
  revisions GCVerificationRevision[]
  @@map("gc_verification_entities")
}

// Identity overlays only. Source identities and original relationship endpoints
// are never rewritten by a merge or its reversal.
model GCMergeProposal {
  id String @id
  kind String
  keys Json
  canonicalKey String @map("canonical_key")
  resolutions Json
  explanation String
  citation String @default("")
  contextHash String @map("context_hash")
  records Json
  status String @default("pending")
  version Int @default(1)
  proposerId String @map("proposer_id")
  proposer User @relation(fields: [proposerId], references: [id], onDelete: Restrict)
  proposerName String @map("proposer_name")
  createdAt DateTime @default(now()) @map("created_at")
  events GCMergeEvent[]
  @@index([kind, createdAt(sort: Desc), id(sort: Desc)], map: "gc_merge_kind_history")
  @@map("gc_merge_proposals")
}

model GCMergeEvent {
  id String @id
  proposalId String @map("proposal_id")
  proposal GCMergeProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  action String
  actorId String @map("actor_id")
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorName String @map("actor_name")
  explanation String
  createdAt DateTime @default(now()) @map("created_at")
  @@index([proposalId, createdAt, id], map: "gc_merge_event_history")
  @@map("gc_merge_events")
}

model GCVerificationRevision {
  id String @id
  submissionId String? @map("submission_id")
  submission GCVerificationRevision? @relation("SubmissionVersions", fields: [submissionId], references: [id])
  versions GCVerificationRevision[] @relation("SubmissionVersions")
  amendsRevisionId String? @map("amends_revision_id")
  amends GCVerificationRevision? @relation("AmendmentPredecessor", fields: [amendsRevisionId], references: [id])
  amendments GCVerificationRevision[] @relation("AmendmentPredecessor")
  entityKey String @map("entity_key")
  entity GCVerificationEntity @relation(fields: [entityKey], references: [key])
  revision Int
  values Json
  coverage Json
  sourcePayload Json @map("source_payload")
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  firstName String @map("first_name")
  lastName String @map("last_name")
  createdAt DateTime @default(now()) @map("created_at")
  source String?
  @@unique([entityKey, revision])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "gc_revision_owner_history")
  @@index([submissionId, revision(sort: Desc)], map: "gc_revision_submission")
  @@map("gc_verification_revisions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([expiresAt])
  @@map("verifications")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Notificaitons

enum NotificationType {
  NEUTRAL
  POSITIVE
  NEGATIVE
}

enum NotificationTags {
  ACCOUNT
}

model Notification {
  id String @id @default(cuid())

  title   String
  message String
  type    NotificationType @default(NEUTRAL)
  tags    String[]
  route   String?

  createdBy User   @relation(fields: [creatorId], references: [id])
  creatorId String @map("creator_id")

  /// @kyselyType({ roles: Role[] })
  target Json?

  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @map("updated_at")
  UserNotification UserNotification[]

  @@map("notifications")
}

model UserNotification {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  notification   Notification @relation(fields: [notificationId], references: [id])
  notificationId String       @map("notification_id")

  seen     Boolean @default(false)
  archived Boolean @default(false)
  clicked  Boolean @default(false)

  @@map("user_notifications")
}

model UserActivity {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  action    String
  requestId String?  @map("request_id")
  values    String[]

  parentId String?        @map("parent_id")
  parent   UserActivity?  @relation("user_activities", fields: [parentId], references: [id])
  children UserActivity[] @relation("user_activities")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_activities")
}

enum StatusType {
  TEMPORARY
  PERMANENT
}

model Media {
  id        String     @id @default(cuid())
  fileName  String     @map("file_name")
  objectKey String     @map("object_key")
  type      String
  size      Int
  status    StatusType @default(TEMPORARY)

  userImage User? @relation("image")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(name: "media", fields: [userId], references: [id])


  @@map("media")
}
