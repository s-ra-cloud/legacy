{
  "kind": "collectionType",
  "collectionName": "requested_books",
  "info": {
    "singularName": "requested-book",
    "pluralName": "requested-books",
    "displayName": "Requested books",
    "description": "Books requested by users to be added"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "bookName": {
      "type": "string",
      "required": false
    },
    "authorName": {
      "type": "string",
      "required": true
    },
    "requesterEmail": {
      "type": "string",
      "private": true
    },
    "requesterUserId": { "type": "string", "private": true },
    "entityType": { "type": "enumeration", "enum": ["author", "work"], "default": "work" },
    "reviewStatus": { "type": "enumeration", "enum": ["proposed", "accepted", "rejected"], "default": "proposed" },
    "reviewNote": { "type": "text" },
    "reviewedBy": { "type": "string", "private": true },
    "linkedEntityDocumentId": { "type": "string" },
    "contributionDocumentId": { "type": "string" },
    "authorDocumentId": { "type": "string" },
    "dependsOnRequestDocumentId": { "type": "string" }
  }
}