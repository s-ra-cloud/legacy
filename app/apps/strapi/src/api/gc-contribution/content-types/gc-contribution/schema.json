{
  "kind": "collectionType",
  "collectionName": "gc_contributions",
  "info": {
    "singularName": "gc-contribution",
    "pluralName": "gc-contributions",
    "displayName": "GC Contribution"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "rest": {
      "expose": true
    }
  },
  "attributes": {
    "connectionType": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "explicit",
        "implicit"
      ]
    },
    "connectionSource": {
      "type": "enumeration",
      "enum": ["archive", "scholar", "ai"]
    },
    "connectionNature": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "agreement",
        "neutral / unsure",
        "opposition",
        "neutral",
        "mixed"
      ]
    },
    "isSimilarityIdeas": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "connectionType"
            },
            "implicit"
          ]
        }
      },
      "default": false
    },
    "isBiographical": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "connectionType"
            },
            "implicit"
          ]
        }
      },
      "default": false
    },
    "isOther": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "connectionType"
            },
            "implicit"
          ]
        }
      },
      "default": false
    },
    "explainConnection": {
      "type": "text"
    },
    "connectionUncertain": { "type": "boolean" },
    "originComment": { "type": "text" },
    "supportingReference": { "type": "text" },
    "contributorEmail": {
      "type": "string",
      "required": false,
      "private": true
    },
    "contributorUserId": { "type": "string", "private": true },
    "contributorName": { "type": "string" },
    "contributorInstitution": { "type": "string" },
    "bookA_id": {
      "type": "string",
      "required": true
    },
    "bookB_id": {
      "type": "string",
      "required": false
    },
    "bookA_textExcerpt": {
      "type": "text",
      "required": true
    },
    "bookB_textExcerpt": {
      "type": "text",
      "required": false
    },
    "bookA_title": {
      "type": "string",
      "required": true
    },
    "bookB_title": {
      "type": "string",
      "required": false
    },
    "referenceDetails": { "type": "json" },
    "referenceRevisionHistory": { "type": "json", "private": true },
    "submissionKey": { "type": "string" },
    "submissionFingerprint": { "type": "string", "private": true },
    "connectionReviewStatus": {
      "type": "enumeration",
      "enum": ["catalogue_review", "ready_to_continue", "editorial_review", "accepted", "rejected"]
    },
    "connectionReviewNote": { "type": "text" },
    "connectionReviewedBy": { "type": "string", "private": true },
    "continuationKey": { "type": "string", "private": true },
    "continuationFingerprint": { "type": "string", "private": true },
    "books": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::book.book",
      "mappedBy": "gc_contributions"
    },
    "gc_comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gc-comment.gc-comment",
      "mappedBy": "gc_contribution"
    }
  }
}
