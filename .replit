modules = ["nodejs-22", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "gc-regressions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "gc-ui-regressions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "library-regressions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "kt-relationship-regressions"

[[workflows.workflow]]
name = "gc-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts test:gc"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "gc-ui-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts test:gc-ui"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "library-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts test:library"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "kt-relationship-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts test:kt-relationships"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["javascript_object_storage:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[userenv]

[userenv.production]

[userenv.shared]
STRAPI_SYNC_TEAM = "1"

[nix]
channel = "stable-25_05"
packages = ["minio", "nginx", "postgresql", "redis"]

[[ports]]
localPort = 1337
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 3002

[[ports]]
localPort = 9000
externalPort = 9000
exposeLocalhost = true
